# Optional overrides for docker compose. Copy to .env (gitignored) and change what you need.
# Every variable has a local-dev default in docker-compose.yml, so this file isn't required.
# Real environments get these from AWS Secrets Manager, never from a file.

# Postgres password, used by both the postgres container and claims-service.
# Postgres only applies it when the data volume is first created: after changing it,
# run `docker compose down --volumes`. For IDE runs of claims-service, also set DB_PASSWORD.
POSTGRES_PASSWORD=claims

# Shared key claims-service sends to fraud-service.
FRAUD_API_KEY=local-dev-fraud-key

# HMAC key fraud-service uses to pseudonymise member identifiers before storing them.
FRAUD_MEMBER_HASH_KEY=local-dev-only-not-a-secret

# HMAC secret for signing the API's JWTs (at least 32 bytes).
JWT_SECRET=local-dev-only-hmac-secret-change-me-0123456789
